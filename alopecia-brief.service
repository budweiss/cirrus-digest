[Unit]
Description=ALOPECIA weekly brief (S95) — council synthesis of the collected corpus, emailed to Buddy
After=network-online.target cumulus-creds-materialize.service
Wants=network-online.target

[Service]
Type=oneshot
User=buddy
Group=buddy
WorkingDirectory=/home/buddy/cirrus-digest
Environment=HOME=/home/buddy
Environment=TARGET_ENV=beta
ExecStart=/home/buddy/cirrus-digest/.venv/bin/python /home/buddy/cirrus-digest/alopecia_brief.py

[Install]
WantedBy=multi-user.target

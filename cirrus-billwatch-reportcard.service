# S537: Monday report card on Bill's three emails (bill_watch.py).
[Unit]
Description=cirrus-billwatch-reportcard (beta)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=buddy
Group=buddy
WorkingDirectory=/home/buddy/cirrus-digest
Environment=HOME=/home/buddy
Environment=TARGET_ENV=beta
ExecStart=/home/buddy/cirrus-digest/.venv/bin/python /home/buddy/cirrus-digest/bill_watch.py reportcard
TimeoutStartSec=600

[Unit]
Description=Halftime act catalogue (S78) — non-marching-band football halftime entertainment
After=network-online.target cumulus-creds-materialize.service
Wants=network-online.target

[Service]
Type=oneshot
User=buddy
Group=buddy
WorkingDirectory=/home/buddy/cirrus-digest
Environment=HOME=/home/buddy
Environment=TARGET_ENV=beta
ExecStart=/home/buddy/cirrus-digest/.venv/bin/python /home/buddy/cirrus-digest/halftime_catalogue.py

[Install]
WantedBy=multi-user.target

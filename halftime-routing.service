[Unit]
Description=Halftime routing sweep (S79) — who is announced near each Steelers home date
After=network-online.target cumulus-creds-materialize.service
Wants=network-online.target

[Service]
Type=oneshot
User=buddy
Group=buddy
WorkingDirectory=/home/buddy/cirrus-digest
Environment=HOME=/home/buddy
Environment=TARGET_ENV=beta
# S155 (Buddy: "bump routing to 8 workers now") — Phase D step 2, after three
# catalogue runs on the endpoint were read clean (S3 held, escalation 0% on two
# of three). Same reasoning as the catalogue unit: the extraction calls go to
# the TP=2 vLLM endpoint (vllm_url in credentials), which batches, so eight
# concurrent model calls instead of one. Without vllm_url this must stay 1 --
# ollama cannot batch and S119 measured escalation 2/7 -> 6/7 at concurrency.
Environment=HALFTIME_ROUTING_EXTRACT_WORKERS=8
# 8 games x 7 metros, each a search + fetches + a model call: the first full
# sweep took about two hours. Set EXPLICITLY rather than trusting the oneshot
# default, because a start timeout that kills the job at 90 seconds would leave
# a half-written routing.json and look like a thin week rather than a failure.
TimeoutStartSec=4h
ExecStart=/home/buddy/cirrus-digest/.venv/bin/python /home/buddy/cirrus-digest/halftime_routing.py

# Rebuild the page this job feeds. Without it the sweep and the
# catalogue would keep updating their data while halftime_serve.py
# kept serving a frozen index.html - a dashboard that silently stops
# moving is worse than one that is obviously empty, because the
# client has no way to tell.
ExecStartPost=/home/buddy/cirrus-digest/.venv/bin/python /home/buddy/cirrus-digest/halftime_dashboard.py

[Install]
WantedBy=multi-user.target

[Unit]
Description=Halftime routing sweep — nightly, ahead of each day

# 22:00 DAILY. Was Sunday-only when the job was built (S79); Buddy asked for it
# nightly and /etc was changed to match, but this file was not — so repo and
# live drifted, and `halftime-routing-install` would have silently cp'd the
# weekly schedule back over the daily one, skipping Justin's board until the
# next Sunday with nothing to say it had happened. Corrected S155; see T91.
#
# Slot chosen from a live window-audit, not by eyeballing:
#   21:30-21:45 com.cirrus.devloop is the last thing before it, and the next
#   scheduled job of any kind is 02:00 (com.cirrus.daily + opportunity-scout).
#   That is a four-hour clear runway for a two-hour job, and it is nowhere near
#   Bill's Monday 04:00/04:30/05:00 client-facing block.
#
# Retiming this is NOT `systemctl restart` — see T39.
[Timer]
OnCalendar=*-*-* 22:00:00
Persistent=true

[Install]
WantedBy=timers.target

[Unit]
Description=Halftime dashboard (S79) — serves ONE page to Justin via Cloudflare Access
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=buddy
Group=buddy
WorkingDirectory=/home/buddy/cirrus-digest
Environment=HOME=/home/buddy
ExecStart=/home/buddy/cirrus-digest/.venv/bin/python /home/buddy/cirrus-digest/halftime_serve.py
Restart=on-failure
RestartSec=10

# It serves one hard-coded file and binds to 127.0.0.1. These make that true at
# the kernel level rather than only in the code: even a defect in the handler
# cannot reach the credential files this tree keeps on disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/buddy/cirrus-digest/out/halftime
InaccessiblePaths=/home/buddy/cirrus-digest/config
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target

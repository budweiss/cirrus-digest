[Unit]
Description=Immaculate Wednesday resolve — Wed 06:50 (S253)

# WHY THIS MOVED HERE (S253, 2026-09-22). This was the desktop-app scheduled
# task `immaculate-wednesday-resolve` on Buddy's MacBook, ~08:00 Wednesdays.
# Those fire only while the laptop is awake -- same reason the daily check
# moved (see immaculate-agent-daily.timer).
#
# 06:50, not 08:00: on this box `window-audit` sees it, and 08:00 is inside
# the Mon-Fri 08:00-16:00 local-use window and after the 07:30 morning brief.
# 06:50 clears halftime-catalogue (06:30, ~15 min), lands in the brief, and
# leaves over two hours before immaculate-wednesday-report (09:05) reads what
# this records. It runs BEFORE the 07:15 daily check, so both run the contest
# watch and both can alert -- whichever sees a new contest first says so.
#
# Retiming is `cumulus-schedule`, never a bare restart (T39).
[Timer]
OnCalendar=Wed *-*-* 06:50:00
Persistent=true

[Install]
WantedBy=timers.target

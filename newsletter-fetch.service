[Unit]
Description=Newsletter fetch (S528) — read-only save of allowlisted issues from Buddy's Yahoo and Gmail
After=network-online.target cumulus-creds-materialize.service
Wants=network-online.target

# The Stock Pickers letters read the last four days of this archive for
# Seeking Alpha idea leads. Until S528 nothing ran this fetch on a schedule, so
# the archive silently stopped at 2026-10-12 and every letter from about
# 10-16 considered zero SA items (T168). The script runs both mailboxes even if
# one fails, records job_status "newsletterfetch", and fails the unit on any failure.

[Service]
Type=oneshot
User=buddy
Group=buddy
WorkingDirectory=/home/buddy/cirrus-digest
Environment=HOME=/home/buddy
TimeoutStartSec=30min
ExecStart=/bin/bash /home/buddy/cirrus-digest/newsletter_fetch_scheduled.sh

[Install]
WantedBy=multi-user.target

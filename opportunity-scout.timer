[Unit]
Description=Run the opportunity scout nightly

# 02:15 — inside the preferred 02:00-06:00 window (docs/RUNTIME-WINDOWS.md),
# 45 minutes before cirrus-hoaleads at 03:00, and long before the 07:30
# morning brief so the night's thinking is there to read at breakfast.
#
# Written as 02:00; the box has run 02:15 for some time and only the
# OnCalendar line was changed there, so this file (and its comment) said
# something the job had stopped doing. Repo brought to match live in S155 --
# the T91 class: an installer copies FROM here, so a stale value here is a
# retiming waiting to happen.
[Timer]
OnCalendar=*-*-* 02:15:00
Persistent=true

[Install]
WantedBy=timers.target

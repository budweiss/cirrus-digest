# platform.env — per-node config read by provision.sh
# Copy to platform.env on each box and edit. NEVER commit the real file if it
# ever holds anything sensitive (it should not — secrets live in credentials.json).
#
# This is the ONE file that differs between CIRRUS / CUMULUS / STRATUS.
# Everything else (app code, requirements, service manifest) is identical.

# ── CIRRUS (dev / current-prod, macOS) ───────────────────────────────────────
# TARGET_ENV=dev
# MODEL_BACKEND=ollama-metal
# SERVICE_MANAGER=launchd
# APP_DIR=/Users/buddy/projects/cirrus-digest
# MODEL_DEFAULT=qwen2.5:14b        # 14b on 64 GB for throughput
# EMBED_MODEL=nomic-embed-text
# SUBDOMAIN=cirrus.cirrustask.com
# TUNNEL_PORT=5001

# ── CUMULUS (beta, DGX Spark / ARM64 / CUDA) ─────────────────────────────────
TARGET_ENV=beta
MODEL_BACKEND=vllm               # or ollama-cuda — decide by benchmark on arrival
SERVICE_MANAGER=systemd
APP_DIR=/home/buddy/cirrus-digest
MODEL_DEFAULT=qwen2.5:72b        # 128 GB makes 72b the default
EMBED_MODEL=nomic-embed-text
SUBDOMAIN=cumulus.cirrustask.com
TUNNEL_PORT=5001
# resource isolation (systemd) — keep scraping jobs from starving the model:
MEMORY_MAX=                      # e.g. 24G on a per-job override
CPU_QUOTA=                       # e.g. 400%

# ── STRATUS (prod, 3× — later) ───────────────────────────────────────────────
# TARGET_ENV=prod                # provision.sh refuses live services without a
# MODEL_BACKEND=vllm             #   logs/self-changes/cumulus-soak-PASS record
# SERVICE_MANAGER=systemd
# APP_DIR=/home/buddy/cirrus-digest
# MODEL_DEFAULT=qwen2.5:72b      # (or whatever the CUMULUS benchmark proves out)
# EMBED_MODEL=nomic-embed-text
# SUBDOMAIN=stratus.stratustask.com
# TUNNEL_PORT=5001

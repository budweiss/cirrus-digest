[Unit]
Description=Independent Qwen FP8 local worker (CUMULUS 2)
After=network-online.target

[Service]
Type=simple
Environment=GPU_UTIL=0.40
Environment=MAXLEN=32768
Environment=MTP=3
ExecStart=/bin/bash %h/vllm/serve.sh --tensor-parallel-size 1 --distributed-executor-backend mp --max-num-seqs 2 --max-num-batched-tokens 4096
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec=60
NoNewPrivileges=true

[Install]
WantedBy=default.target

# cumulus-supervisor sudoers — B1 supervisor agent (S63)
# S81 (Buddy 2026-08-27): the four always-on services added below.
# Kept in lockstep with tools.ALLOWED_UNITS -- supervisor selftest
# now parses THIS FILE and fails if the two disagree.
# Narrow, explicit allowlist: restart/reset-failed on the fixed reversible-action
# unit list from CUMULUS.md §4. No wildcards (sudoers wildcard argument matching
# is exploitable) — every command spelled out in full.
Cmnd_Alias SUPERVISOR_RESTART = \
    /usr/bin/systemctl restart cirrus-api.service, \
    /usr/bin/systemctl restart cirrus-bot.service, \
    /usr/bin/systemctl restart cirrus-billnewdev.service, \
    /usr/bin/systemctl restart cirrus-billsnow.service, \
    /usr/bin/systemctl restart cirrus-hoaleads.service, \
    /usr/bin/systemctl restart cirrus-modelhealth.service, \
    /usr/bin/systemctl restart cirrus-pedagogy.service, \
    /usr/bin/systemctl restart cumulus-creds-materialize.service, \
    /usr/bin/systemctl restart cumulus-intake.service, \
    /usr/bin/systemctl restart cirrus-offer.service, \
    /usr/bin/systemctl restart cloudflared.service, \
    /usr/bin/systemctl restart halftime-serve.service, \
    /usr/bin/systemctl restart ollama.service

Cmnd_Alias SUPERVISOR_RESET = \
    /usr/bin/systemctl reset-failed cirrus-api.service, \
    /usr/bin/systemctl reset-failed cirrus-bot.service, \
    /usr/bin/systemctl reset-failed cirrus-billnewdev.service, \
    /usr/bin/systemctl reset-failed cirrus-billsnow.service, \
    /usr/bin/systemctl reset-failed cirrus-hoaleads.service, \
    /usr/bin/systemctl reset-failed cirrus-modelhealth.service, \
    /usr/bin/systemctl reset-failed cirrus-pedagogy.service, \
    /usr/bin/systemctl reset-failed cumulus-creds-materialize.service, \
    /usr/bin/systemctl reset-failed cumulus-intake.service, \
    /usr/bin/systemctl reset-failed cirrus-offer.service, \
    /usr/bin/systemctl reset-failed cloudflared.service, \
    /usr/bin/systemctl reset-failed halftime-serve.service, \
    /usr/bin/systemctl reset-failed ollama.service

cumulus-supervisor ALL=(root) NOPASSWD: SUPERVISOR_RESTART, SUPERVISOR_RESET

# Read-only credential-health probe. Runs AS buddy (who owns the credentials
# file) because cumulus-supervisor cannot traverse /home/buddy (750). The
# script is fixed, root-owned, mode 755 — cumulus-supervisor cannot edit it,
# so this does not grant arbitrary code execution as buddy.
cumulus-supervisor ALL=(buddy) NOPASSWD: /usr/local/sbin/cumulus_creds_health.py

# Read-only client-conversation probe (S78). Same shape and same reason as the
# credential probe above: the four checks that watch client conversations
# (promises, duplicate answers, thread stalls, field overwrites) all import
# modules under /home/buddy, which this account cannot traverse. They shipped
# unable to run, and reported "UNREADABLE" every time.
#
# Chosen over widening filesystem access on purpose. This grants ONE fixed,
# root-owned, non-editable script producing ONE fixed JSON digest -- counts and
# labels, never a client's prose. It is not a general read of the checkout, and
# the agent cannot repoint it. Adding cumulus-supervisor to the `buddy` group
# would have been far worse: cirrus-digest is 775 and its files 664, so that
# grants WRITE on the app checkout to a read-only agent.
cumulus-supervisor ALL=(buddy) NOPASSWD: /usr/local/sbin/cumulus_client_watch.py, \
    /usr/local/sbin/cumulus_client_watch.py [0-9]*

# S91 — repair-ticket filer. Same shape and same reason as the two probes above:
# it imports dev_loop from /home/buddy, which this account cannot traverse.
#
# Unlike those two, this one WRITES, so the narrowing matters more:
#   * NO ARGUMENTS AT ALL, so this grant needs no wildcard (see this file's
#     header — wildcard argument matching is exploitable). The payload arrives
#     on stdin, which also keeps a journal excerpt out of the world-readable
#     process table.
#
#     The trailing "" is load-bearing and is NOT decoration. In sudoers a bare
#     command path permits that command with ANY arguments; only an explicit ""
#     restricts it to no arguments at all. Measured on cumulus1 2026-09-01:
#     with the bare path, `... cumulus_file_ticket.py extra-arg` was permitted
#     by sudo and stopped only by the script's own argv check. Defense in depth
#     is good, but the grant should not be quietly wider than its comment says.
#   * It appends to ONE file, the dev-loop ticket queue, and can do nothing
#     else. requester, origin and project are hardcoded in the script, so a
#     ticket cannot be filed under another identity or aimed at another project.
#   * Root-owned, mode 755, outside supervisor/app/ — cumulus-supervisor cannot
#     edit it, so this is not arbitrary code execution as buddy.
#
# Why it exists: on 2026-08-31 cirrus-modelhealth failed on a code bug. Every
# check and escalation in this agent worked correctly and it still waited two
# days, because restart_service is the only repair on the allowlist and a
# Telegram is not a repair. This gives the agent a way to file WORK.
#
# Filing is not shipping. dev_loop risk-classifies the ticket; at most it
# becomes a patch waiting in awaiting-confirm for Buddy's one tap.
cumulus-supervisor ALL=(buddy) NOPASSWD: /usr/local/sbin/cumulus_file_ticket.py ""

# S96 — read-only job-status feed. Same shape and same reason as the two probes
# above: completeness.check() reads the run ledger under /home/buddy, which this
# account cannot traverse (/home/buddy is 750). Measured 2026-09-02: the
# supervisor could see ZERO jobs, and because a missing file loads as {} it had
# been reporting "all jobs producing" since S67 without ever reading one.
#
# Chosen over widening filesystem access, for the reason already written above:
# adding cumulus-supervisor to the `buddy` group grants WRITE on a 775 checkout
# with 664 files to a read-only agent. Chosen over a copy-on-a-timer because a
# stopped copier leaves a frozen ledger that still reads as real data; this
# reads live, so there is nothing to go stale.
#
# ONE fixed, root-owned, non-editable script producing ONE fixed JSON digest:
# job names, run timestamps, ok flags, and the short counter notes the
# completeness rules already parse — plus the cadence table from job_status.py.
# Operational metadata only. Not a general read of the checkout, and the agent
# cannot repoint it.
#
# NO ARGUMENTS, so this grant needs no wildcard (see this file's header —
# wildcard argument matching is exploitable). The trailing "" is load-bearing
# and is NOT decoration: a bare command path permits that command with ANY
# arguments; only an explicit "" restricts it to none. The script re-checks argv
# itself, but the grant must not be quietly wider than its comment says (S91).
cumulus-supervisor ALL=(buddy) NOPASSWD: /usr/local/sbin/cumulus_job_status.py ""
